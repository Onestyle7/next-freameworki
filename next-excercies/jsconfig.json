{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "../dist",
    "moduleResolution": "Node",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["*.ts"]
}
